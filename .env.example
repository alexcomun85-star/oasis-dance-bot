# Скопируйте этот файл в .env и заполните значения.
# Секреты берутся из Replit: вкладка Tools → Secrets проекта TelegramBotHelper.

# Токен бота @oasisdance_show_bot (обязательно). Новый можно получить у @BotFather командой /token
TELEGRAM_BOT_TOKEN=

# Числовые Telegram ID тех, кому приходят заявки, через запятую.
# Свой ID можно узнать, написав боту команду /myid
ADMIN_CHAT_IDS=5163700657

# Ключ Google Gemini для ИИ-ассистента (необязательно; без ключа кнопка ассистента скрывается)
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Контакты (пустые строки не показываются)
MANAGER_USERNAME=EbruBekker
MANAGER_PHONE=
MANAGER_EMAIL=
WORK_HOURS=ежедневно с 10:00 до 20:00
INSTAGRAM_URL=https://www.instagram.com/ebru.dance
VK_URL=https://vk.com/oasis_dance_show
CHANNEL_URL=https://t.me/oasis_dance_show

# Ограничения ассистента: вопросов на человека в час и всего в сутки
AI_LIMIT_PER_USER_HOUR=20
AI_LIMIT_PER_DAY=500
# Через сколько минут незаконченная заявка считается брошенной (придёт уведомление)
ABANDON_MINUTES=30
# Кто обрабатывает персональные данные (показывается в согласии и /privacy)
OPERATOR_NAME=шоу-балет Oasis Dance

# Канал, куда бот публикует посты командой /post (бот — администратор канала)
CHANNEL_ID=@oasis_dance_show

# --- Соцсети → канал ---
# Сервисный ключ приложения ВКонтакте (как получить — README, раздел «Соцсети → канал»)
VK_SERVICE_TOKEN=
# Страницы ВК через запятую: oasis_dance_show, id123456 (человек), -123456 (группа)
VK_SOURCES=oasis_dance_show
SOURCE_CHECK_MINUTES=20
# 1 — публиковать сразу, 0 — сначала черновик администратору
AUTO_PUBLISH=0
# Ленты без ключей через запятую: RSS/Atom (rss.app, vkrss.com и т.п.) или JSON. По умолчанию — Instagram oasis_dance_show,
# который раз в день обновляет задание по расписанию в Claude (файл feeds/instagram.json в репозитории)
FEED_SOURCES=https://raw.githubusercontent.com/alexcomun85-star/oasis-dance-bot/main/feeds/instagram.json
# Пометка к постам из Instagram (оставьте пустым, чтобы убрать)
INSTAGRAM_NOTE=Instagram принадлежит компании Meta, признанной экстремистской и запрещённой в РФ.

# Тексты постов из соцсетей: copy — как в оригинале + ссылка, ai — переписывает ИИ (можно переключить кнопкой в /sources)
POST_MODE=copy
